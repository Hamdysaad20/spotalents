# ==============================================================================
# Supabase Configuration for Vercel
# Find these in Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# The URL of your Supabase project (Required)
# Example: https://xyzcompanyproject.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (RECOMMENDED for server-side Vercel Functions)
# This key has administrative privileges to bypass Row Level Security when inserting
# from our secure serverless backend. NEVER expose this in client-side HTML/JS!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Anonymous Key (Fallback if Service Role Key is not configured)
# Public anon key with restricted Row Level Security (RLS) insert permissions.
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Allowed Origin (Optional - default allows same-origin and spotalents domains)
# Set this if you want to strictly restrict submissions to a specific domain.
# ALLOWED_ORIGIN=https://spotalents.com

# ==============================================================================
# Founder Email Notification Configuration
# Automatic lead alerts are sent directly to founders:
FOUNDER_NOTIFICATION_EMAIL=hamdy@spotalents.com,hatemalihassan1@gmail.com,contact@jointhedragons.com
# Default fallback recipients if unset: hatemalihassan1@gmail.com, contact@jointhedragons.com
# ==============================================================================

# Option A: Resend API (Recommended for Vercel - https://resend.com)
# Create a free account on resend.com, grab your API key, and paste below:
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Spotalents Inbound <onboarding@resend.dev>

# Option B: Nodemailer / Gmail SMTP (Using Google App Password)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/apppasswords and create an App Password
# 3. Enter credentials below:
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# Option C: Custom SMTP (Google Workspace, AWS SES, Postmark, Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Option D: SendGrid API
# SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Notification Recipients (Optional override - defaults to both founders)
# NOTIFICATION_RECIPIENTS=hatemalihassan1@gmail.com, contact@jointhedragons.com
